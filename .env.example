# Copy to .env and edit before: docker compose up -d --build
#   cp .env.example .env

APP_ENV=production
# Empty APP_BASE = site at http://host:port/ (recommended for Docker)
APP_BASE=
APP_URL=http://localhost:8088
APP_PORT=8088
APP_SESSION_IDLE_SECONDS=7200

DB_NAME=inventory_system
DB_USER=inventory
DB_PASS=change-me-strong-db-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# Optional Google OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail: log (local) | smtp (production password reset)
MAIL_DRIVER=log
MAIL_FROM=noreply@your-domain.com
MAIL_FROM_NAME=Inventory Management System
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
